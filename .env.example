# Copy to .env locally. NEVER commit .env / session.json / cookies.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION=
SESSION_ID=
CSRF_TOKEN=
DS_USER_ID=
DESTINATION_USERNAME=

TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

UPLOAD_SECRET=change-me-long-random

REEL_FETCH_COUNT=30
MAX_UPLOADS_PER_RUN=1
HIDE_LIKE_VIEW_COUNTS=true
SHARE_TO_FEED=true

COVER_MODE=random
COVER_FILE=
COVER_DIR=cover
# URL cover: downloaded once, cached until URL changes. Overrides COVER_MODE when set.
COVER_URL=https://i.ibb.co/sp6WvzJK/1.jpg
REEL_CAPTION=🎬 via @{username} #reels

# Proxy (optional): empty = direct connection. Supports http/https/socks5/socks5h.
PROXY_URL=

# Telegram logs (optional, off by default). Create a bot via @BotFather for the
# token, then message it and resolve your numeric chat id via getUpdates.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
